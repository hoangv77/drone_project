<?xml version="1.0"?>
<package format="3">
  <name>px4_interface_node</name>
  <version>0.0.0</version>

  <description>
    Bidirectional PX4 telemetry and guarded commands with acknowledgment and state verification.
  </description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <!-- Use ROS 2's CMake-based build system. -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencies used by the C++ node and DroneState message. -->
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>px4_msgs</depend>
  <depend>builtin_interfaces</depend>

  <!-- Generate C++ code from the custom message and service. -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_index_python</test_depend>

  <!-- Required because this package defines custom ROS interfaces. -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
