<?xml version="1.0"?>
<package format="3">
  <name>px4_interface_node</name>
  <version>0.0.0</version>

  <description>
    Read-only ROS 2 interface that converts PX4 telemetry into a clean drone state.
  </description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <!-- Use ROS 2's CMake-based build system. -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencies used by the C++ node and DroneState message. -->
  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>builtin_interfaces</depend>

  <!-- Generate C++ code from msg/DroneState.msg. -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Required because this package defines a custom ROS message. -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
