# Controlled command whitelist. No raw PX4 command IDs or force-arm flags.
uint8 SET_MODE=0
uint8 ARM=1
uint8 DISARM=2
uint8 RUN_PREFLIGHT_CHECKS=3
uint8 command
# Required only for SET_MODE; use the uppercase /drone/state mode name.
string mode
---
uint8 SUCCESS=0
uint8 INVALID_REQUEST=1
uint8 BUSY=2
uint8 STATUS_UNAVAILABLE=3
uint8 REJECTED=4
uint8 ACK_TIMEOUT=5
uint8 TRANSITION_TIMEOUT=6
uint8 PREFLIGHT_FAILED=7
uint8 GCS_UNAVAILABLE=8
uint8 FAILSAFE_ACTIVE=9
uint8 LANDED_UNAVAILABLE=10
uint8 UNSAFE_DISARM=11
uint8 NO_ACK=255
uint64 request_id
uint8 command
bool success
bool accepted
uint8 result
uint8 ack_result
uint8 ack_result_param1
int32 ack_result_param2
string current_mode
bool armed
bool status_fresh
string message
