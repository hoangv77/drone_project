[Unit]
Description=Drone PX4 Micro XRCE-DDS Agent
After=network.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=drone-runtime
SupplementaryGroups=dialout
EnvironmentFile=/etc/drone/drone.env
ExecStartPre=+/usr/bin/python3 -I /opt/drone/recovery/activation.py boot
ExecStart=/usr/bin/python3 -I /opt/drone/recovery/activation.py launch agent
ReadWritePaths=/opt/drone/state
Restart=always
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
