[Unit]
Description=Drone onboard passive ROS 2 stack
Wants=drone-agent.service
After=drone-agent.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=drone-runtime
StateDirectory=drone-runtime
Environment=ROS_LOG_DIR=/var/lib/drone-runtime/log
EnvironmentFile=/etc/drone/drone.env
ExecStartPre=+/usr/bin/python3 -I /opt/drone/recovery/activation.py boot
ExecStart=/usr/bin/python3 -I /opt/drone/recovery/activation.py launch stack
ReadWritePaths=/opt/drone/state
Restart=always
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
